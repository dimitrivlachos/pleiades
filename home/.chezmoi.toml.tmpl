{{- $specialisation := promptChoiceOnce . "specialisation" "Machine specialisation" (list "frostpaw" "diamond" "asteria") -}}

# Generated by `chezmoi init` from home/.chezmoi.toml.tmpl.
# Edit the source template, not ~/.config/chezmoi/chezmoi.toml directly.

[data]
    specialisation = {{ $specialisation | quote }}

# --- Age encryption (wired in Phase 4 of the chezmoi migration) ---
# Uncomment once the keypair exists and the recipient is filled in.
# Place the private key at ~/.config/chezmoi/key.txt on each machine.
#
# encryption = "age"
# [age]
#     identity = "~/.config/chezmoi/key.txt"
#     recipient = "age1REPLACE_WITH_PUBLIC_KEY"
