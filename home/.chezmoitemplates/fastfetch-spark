{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file",
    "source": "{{ .chezmoi.homeDir }}/.config/fastfetch/logo_nvidia.txt",
    "color": {"1": "green"},
    "width": 1,
    "height": 22,
    "padding": {
      "top": 1,
      "left": 0
    }
  },
  "modules": [
    { "type": "custom", "format": "\u001b[90m┌──────────────────────Hardware──────────────────────┐" },
    { "type": "host",   "key": " PC", "keyColor": "green" },
    { "type": "cpu",    "key": "│ ├", "keyColor": "green" },
    { "type": "gpu",    "key": "│ ├󰍛", "keyColor": "green" },
    { "type": "memory", "key": "│ ├󰍛", "keyColor": "green" },
    { "type": "disk",   "key": "└ └", "keyColor": "green" },
    { "type": "custom", "format": "\u001b[90m└────────────────────────────────────────────────────┘" },
    "break",

    { "type": "custom", "format": "\u001b[90m┌──────────────────────Software──────────────────────┐" },
    { "type": "os",       "key": " OS", "keyColor": "yellow" },
    { "type": "kernel",   "key": "│ ├", "keyColor": "yellow" },
    { "type": "packages", "key": "│ ├󰏖", "keyColor": "yellow" },
    { "type": "shell",    "key": "│ ├", "keyColor": "yellow" },
    { "type": "terminal", "key": "└ └", "keyColor": "yellow" },
    { "type": "custom", "format": "\u001b[90m└────────────────────────────────────────────────────┘" },
    "break",

    { "type": "custom", "format": "\u001b[90m┌──────────────────────System────────────────────────┐" },
    {
      "type": "command",
      "key": "  Login ",
      "keyColor": "magenta",
      "text": "printf '\\033[1;33m%s\\033[0m @ \\033[1;33m%s\\033[0m\\n' \"$USER\" \"${HOSTNAME:-$(uname -n)}\""
    },
    {
      "type": "command",
      "key": "  OS Age ",
      "keyColor": "magenta",
      "text": "birth=$(stat -c %W /); now=$(date +%s); age=$(( (now - birth) / 86400 )); echo \"$age days\""
    },
    {
      "type": "command",
      "key": "  Temps ",
      "keyColor": "magenta",
      "text": "cpu=$(sensors 2>/dev/null | awk '/Tctl|Tdie|Package id 0:/{gsub(/\\+/,\"\"); print $2; exit}'); if [ -z \"$cpu\" ]; then cpu=$(cat /sys/class/thermal/thermal_zone0/temp 2>/dev/null | awk '{printf \"%.1f°C\", $1/1000}'); fi; gpu=$(nvidia-smi --query-gpu=temperature.gpu --format=csv,noheader,nounits 2>/dev/null | awk '{print $1\"°C\"}' || echo 'N/A'); printf '\\033[1;32mCPU:\\033[0m %s \\033[90m|\\033[0m \\033[1;32mGPU:\\033[0m %s\\n' \"${cpu:-N/A}\" \"$gpu\""
    },
    {
      "type": "command",
      "key": "  Load ",
      "keyColor": "magenta",
      "text": "echo \"$(awk '{print $1, $2, $3}' /proc/loadavg) ($(nproc) cores)\""
    },
    { "type": "uptime",   "key": "  Uptime ", "keyColor": "magenta" },
    { "type": "datetime", "key": "  DateTime ", "keyColor": "magenta" },
    { "type": "custom", "format": "\u001b[90m└────────────────────────────────────────────────────┘" },
    { "type": "custom", "format": "\u001b[31m⬤ \u001b[33m⬤ \u001b[32m⬤ \u001b[36m⬤ \u001b[34m⬤ \u001b[35m⬤ \u001b[37m⬤ \u001b[90m⬤\u001b[0m" },
    "break"
  ]
}
