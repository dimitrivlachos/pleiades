# Simple aliases for common operations
alias ssh-setup='bc_ssh_workday_setup proxy'
alias ssh-setup-only='bc_ssh_workday_setup false'
alias ssh-fix-perms='bc_fix_ssh_permissions'
alias ssh-status='bc_ssh_master_status'
alias ssh-master='bc_ssh_master_start'
alias ssh-exit='bc_ssh_master_stop'
alias ssh-agent-status='bc_ssh_agent_status'
alias ssh-agent-prune='bc_ssh_agent_prune'
alias ssh-help='bc_ssh_help'

# ==============================================================================
# MODULE INITIALISATION
# ==============================================================================

# Attach interactive shells to the machine's agent so AddKeysToAgent has
# somewhere to cache keys. Idempotent; reuses before it ever starts anything.
if [[ $- == *i* ]]; then
    bc_ssh_agent_attach
fi