# Pleiades compatibility stub
# ==============================================================================
# This repo is now managed by chezmoi. The modular config no longer lives at
# the repo root; chezmoi deploys it to ~/.config/bash-config and rewrites the
# managed block in ~/.bashrc to source it from there.
#
# This file only exists to catch a machine that still has the old
# `~/.bashrc_core -> <checkout>/bashrc_core` symlink and pulled the migration
# before running the chezmoi bootstrap. Instead of the shell breaking on a
# vanished orchestrator, you get told what to run. Delete this stub once every
# machine has been migrated.
#
# Migration runbook: docs/migrating_to_chezmoi.md
# ==============================================================================

if [[ $- == *i* ]]; then
    printf '\n\033[1;33m[pleiades]\033[0m This repo is now managed by chezmoi.\n'
    printf '  The old ~/.bashrc_core symlink is obsolete and this shell is unconfigured.\n'
    printf '  Migrate this machine (see docs/migrating_to_chezmoi.md):\n'
    printf '    sh -c "$(curl -fsLS get.chezmoi.io)" -- init dimitrivlachos/pleiades\n'
    printf '    cp <your age key> ~/.config/chezmoi/key.txt   # from Vaultwarden\n'
    printf '    chezmoi apply\n\n'
fi

# Sourced from ~/.bashrc; return cleanly so the login shell still works.
return 0 2>/dev/null || true
